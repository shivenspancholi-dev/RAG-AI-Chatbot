{
  "name": "rag-ai-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted Retrieval-Augmented chatbot that answers from your own documents with source citations. No external APIs.",
  "scripts": {
    "ingest": "tsx scripts/ingest.ts",
    "dev": "npm run ingest && next dev",
    "build": "npm run ingest && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
